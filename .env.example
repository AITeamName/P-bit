# ===================================================
# P-bit — 루트 .env.example
# cp .env.example .env  →  값 채우기 (팀 노션 참고)
# 절대 커밋 금지. 이 파일만 커밋합니다.
# ===================================================

### Root
# Docker Compose — PostgreSQL 컨테이너 (docker-compose.yml)
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

### Frontend
# → frontend/web/.env.example 에서 관리 (키 목록: docs/ops/env.md 3절)

### Backend
# 로컬 실행 시 application-local.yml 이 이 파일(루트 .env)을 읽는다 (키 목록: docs/ops/env.md 1절)
# JWT_SECRET : Access Token 서명 키, 32자 이상 (생성: openssl rand -base64 48)
JWT_SECRET=

### AI-Server
# → ai-server/.env.example 에서 관리 (키 목록: docs/ops/env.md 2절)
