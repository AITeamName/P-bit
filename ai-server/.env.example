# ===================================================
# P-bit — ai-server .env.example
# cp .env.example .env  →  값 채우기
# 절대 커밋 금지. 이 파일만 커밋합니다.
# 키 설명·필수 여부: docs/ops/env.md 2절
# 서버 포트(8001)와 루브릭 YAML은 환경변수가 아닙니다.
# ===================================================

### 🔑 비밀값 (필수)
LLM_API_KEY=
# Spring과 같은 이름·같은 값 (X-Internal-Token 검증). 생성·보관: 클라우드
AI_INTERNAL_TOKEN=

### 📝 모델·루브릭 (필수)
# 판정·조립·재판정용 (중급 모델)
LLM_MODEL_JUDGE=
# Before/After 답변·이유 요약용 (경량 모델)
LLM_MODEL_ANSWER=
# prompts/rubric/ 아래 버전 디렉터리 이름과 같아야 함
RUBRIC_VERSION=v1.0

### 📝 선택 (아래는 기본값)
# 타임아웃 순서: 답변 타임아웃 < Nginx(30s) < Spring(35s)
LLM_TIMEOUT_JUDGE_SEC=12
LLM_TIMEOUT_ANSWER_SEC=20
LLM_MAX_RETRY=2
LOG_LEVEL=INFO
